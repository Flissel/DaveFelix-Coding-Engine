# Static production image for the Coding-Engine frontend.
# Produces `vibemind-coding-frontend:static` — an nginx image serving the
# built Vite SPA on :80. The unified Swarm stack (infra/swarm/vibemind-stack.yml,
# service `coding-frontend`) expects exactly this: container :80, with the
# nginx vhost injected at deploy time via the `coding_frontend_nginx` Swarm
# config onto /etc/nginx/conf.d/default.conf — so the image itself ships only
# nginx + the SPA, NOT a vhost (the stack config owns routing/SPA-fallback).
#
# The repo's default `Dockerfile` is the Vite DEV server (:5173) — NOT usable
# for the stack's :80 healthcheck. This file is the production counterpart.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine
# SPA assets only; the vhost arrives via the Swarm `configs:` block.
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
