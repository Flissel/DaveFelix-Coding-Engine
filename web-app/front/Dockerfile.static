# =============================================================================
# coding-engine frontend — SERVER-GRADE static build (Phase 2c)
# =============================================================================
# The original Dockerfile runs `npx vite` (DEV server) — fine for local
# compose live-reload, wrong for a Swarm/server deploy (dev server, needs
# source live, the /api/v1 proxy is a Vite-dev-only feature). This builds
# the SPA to static assets and serves them with nginx, which ALSO proxies
# /api/v1 → coding-api:8000 (incl. WebSocket upgrade for the live-generation
# stream at /api/v1/engine/generation/ws). The nginx vhost is shipped as a
# Swarm config: object (NOT host-bind — same pattern as nginx_media_conf).
#
# Build (driven by the launcher pre-build step / manual):
#   docker build -f web-app/front/Dockerfile.static \
#     -t vibemind-coding-frontend:static web-app/front
# (context = web-app/front so package.json + src/ + vite.config.ts resolve)
# =============================================================================

# ---- Stage 1: build the SPA ------------------------------------------------
FROM node:22-alpine AS builder
WORKDIR /app

# deps first (cache layer — package.json changes less often than src)
COPY package*.json ./
RUN npm install

COPY . .
# vite.config.ts: base defaults to '/' (SPA at root), proxy is dev-only and
# is replaced by the nginx proxy below. `vite build` → /app/dist (static).
RUN npm run build

# ---- Stage 2: lean nginx runtime ------------------------------------------
FROM nginx:alpine AS runtime
# only the built static assets — no node, no source, no node_modules
COPY --from=builder /app/dist /usr/share/nginx/html
# vhost is supplied at deploy time as a Swarm config: mounted onto
# /etc/nginx/conf.d/default.conf (kept out of the image so it can change
# without a rebuild — server-grade, the nginx_media_conf precedent).
EXPOSE 5173
# nginx:alpine default CMD already runs nginx -g 'daemon off;' (foreground).
