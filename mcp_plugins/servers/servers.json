{
  "comment": "MCP Server Registry - Docker/Linux paths for container execution",
  "grpc_config": {
    "base_port": 50061,
    "port_range": "50061-50090",
    "enabled": true
  },
  "servers": [
    {
      "name": "playwright",
      "scope": "global",
      "active": true,
      "type": "stdio",
      "grpc_port": 50061,
      "command": "npx",
      "args": [
        "--yes",
        "@playwright/mcp@latest",
        "--browser=chromium",
        "--viewport-size=1280,720"
      ],
      "read_timeout_seconds": 120,
      "description": "Playwright MCP - Browser automation, DOM interaction, screenshots",
      "host": {
        "command": "npx",
        "args": [
          "-y",
          "@playwright/mcp@latest"
        ]
      }
    },
    {
      "name": "github",
      "scope": "global",
      "active": false,
      "type": "stdio",
      "grpc_port": 50062,
      "command": "npx",
      "args": [
        "--yes",
        "@modelcontextprotocol/server-github"
      ],
      "env_vars": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "env:GITHUB_TOKEN"
      },
      "read_timeout_seconds": 120,
      "description": "GitHub MCP - Repository management, issues, PRs (needs GITHUB_TOKEN)"
    },
    {
      "name": "docker",
      "scope": "global",
      "active": true,
      "type": "stdio",
      "grpc_port": 50063,
      "command": "python",
      "args": [
        "-m",
        "mcp_server_docker"
      ],
      "read_timeout_seconds": 120,
      "description": "Docker MCP - Container operations, compose, logs",
      "host": {
        "command": "${HOME}/.local/bin/docker-mcp.exe",
        "args": []
      }
    },
    {
      "name": "desktop",
      "scope": "global",
      "active": false,
      "type": "stdio",
      "grpc_port": 50064,
      "command": "npx",
      "args": [
        "--yes",
        "@wonderwhy-er/desktop-commander@latest"
      ],
      "read_timeout_seconds": 120,
      "description": "Desktop Commander MCP - Not applicable in Docker"
    },
    {
      "name": "context7",
      "scope": "global",
      "active": true,
      "type": "stdio",
      "grpc_port": 50065,
      "command": "npx",
      "args": [
        "--yes",
        "@upstash/context7-mcp@latest"
      ],
      "read_timeout_seconds": 120,
      "env_vars": {
        "DEFAULT_MINIMUM_TOKENS": "10000"
      },
      "description": "Context7 MCP - Up-to-date library documentation and code examples",
      "host": {
        "command": "npx",
        "args": [
          "-y",
          "@upstash/context7-mcp@latest"
        ]
      }
    },
    {
      "name": "redis",
      "scope": "global",
      "active": true,
      "type": "stdio",
      "grpc_port": 50066,
      "command": "npx",
      "args": [
        "--yes",
        "@modelcontextprotocol/server-redis"
      ],
      "read_timeout_seconds": 120,
      "env_vars": {
        "REDIS_URL": "env:REDIS_URL"
      },
      "description": "Redis MCP - Key-value store, caching",
      "host": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-redis",
          "redis://localhost:6379"
        ]
      }
    },
    {
      "name": "supabase",
      "scope": "global",
      "active": false,
      "type": "stdio",
      "grpc_port": 50067,
      "command": "npx",
      "args": [
        "--yes",
        "@supabase/mcp-server-supabase@latest"
      ],
      "env_vars": {
        "SUPABASE_ACCESS_TOKEN": "env:SUPABASE_ACCESS_TOKEN"
      },
      "read_timeout_seconds": 120,
      "description": "Supabase MCP - PostgreSQL, auth, storage (needs SUPABASE_ACCESS_TOKEN)"
    },
    {
      "name": "time",
      "scope": "global",
      "active": true,
      "type": "stdio",
      "grpc_port": 50068,
      "command": "python",
      "args": [
        "-m",
        "mcp_server_time"
      ],
      "read_timeout_seconds": 120,
      "description": "Time MCP - Current time and timezone operations",
      "host": {
        "command": "${HOME}/.local/bin/mcp-server-time.exe",
        "args": []
      }
    },
    {
      "name": "taskmanager",
      "scope": "global",
      "active": false,
      "type": "stdio",
      "grpc_port": 50069,
      "command": "npx",
      "args": [
        "--yes",
        "@kazuph/mcp-taskmanager"
      ],
      "read_timeout_seconds": 120,
      "env_vars": {
        "TASK_MANAGER_FILE_PATH": "/data/tasks.json"
