    {
      "name": "memory",
      "scope": "global",
      "active": true,
      "type": "stdio",
      "grpc_port": 50071,
      "command": "npx",
      "args": [
        "--yes",
        "@modelcontextprotocol/server-memory"
      ],
      "read_timeout_seconds": 120,
      "description": "Memory MCP - Knowledge graph with entities and relations",
      "host": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-memory"
        ]
      }
    },
    {
      "name": "filesystem",
      "scope": "global",
      "active": true,
      "type": "stdio",
      "grpc_port": 50072,
      "command": "npx",
      "args": [
        "--yes",
        "@modelcontextprotocol/server-filesystem",
