    {
      "name": "npm",
      "scope": "coding-only",
      "active": true,
      "type": "custom",
      "grpc_port": 50080,
      "command": "python",
      "args": [
        "mcp_plugins/servers/npm/agent.py"
      ],
      "cwd": "env:PROJECT_ROOT",
      "read_timeout_seconds": 120,
      "description": "npm/pnpm MCP agent for package management, scripts, and dependency auditing"
    },
    {
      "name": "prisma",
      "scope": "coding-only",
      "active": true,
