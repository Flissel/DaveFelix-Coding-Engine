      "type": "stdio",
      "command": "tavily-mcp",
      "args": [],
      "read_timeout_seconds": 30,
      "description": "Tavily MCP - web search/extraction (host-only; needs TAVILY_API_KEY)",
      "host": {
        "command": "tavily-mcp",
        "args": []
      }
