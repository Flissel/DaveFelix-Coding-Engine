  "inactive_servers_note": "Disabled: github (needs token), desktop (not in Docker), supabase (needs token), brave-search (needs key), taskmanager, youtube, n8n, tavily, puppeteer, huggingface, elevenlabs, mindsdb, gpt-researcher",
  "active_agents_count": 18,
  "custom_agents": [
    "npm",
    "prisma",
    "postgres",
    "qdrant",
    "supermemory",
    "claude-code",
    "fungus"
  ]
}
